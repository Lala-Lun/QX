#!name=小红书去广告更新
#!desc=过滤信息流推广，移除图片及视频水印，支持国内版(xiaohongshu.com)与海外版RedNote(rnote.com/rednote.com/rednote.life/rednotecdn.com)，如有异常，请先清除缓存再尝试。基于kelee插件修改自用。
#!author=RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200]，kelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png
#!date=2026-08-26 13:20:50

[Rule]
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com,extended-matching)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,rnote.com,extended-matching)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,rednote.com,extended-matching)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,rednote.life,extended-matching)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,rednotecdn.com,extended-matching)),REJECT

[Body Rewrite]
http-response-jq ^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v1\/search\/banner_list$ 'if (getpath([]) | has("data")) then (setpath(["data"]; {})) else . end'
http-response-jq ^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v1\/search\/hot_list$ 'if (getpath(["data"]) | has("items")) then (setpath(["data","items"]; [])) else . end'
http-response-jq ^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v4\/search\/hint 'if (getpath(["data"]) | has("hint_words")) then (setpath(["data","hint_words"]; [])) else . end'
http-response-jq ^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v4\/search\/trending\? 'if (getpath(["data"]) | has("queries")) then (setpath(["data","queries"]; [])) else . end'
http-response-jq ^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v4\/search\/trending\? 'if (getpath(["data"]) | has("hint_word")) then (setpath(["data","hint_word"]; {})) else . end'

[Map Local]
^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/system_config\/watermark data-type=tiny-gif status-code=200

^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/marketing\/box\/trigger\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/(?:v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
移除图片和实况照片水印 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除界面整体配置 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v1\/system\/service\/ui\/config\?, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除开屏广告v1 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v1\/system_service\/config\?, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除开屏广告v2 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v2\/system_service\/splash_config, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除详情页小部件、关注页感兴趣的人 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除信息流广告v1 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v4\/followfeed\?, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除详情页感兴趣的人 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v5\/recommend\/user\/follow_recommend\?, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除评论区实况照片水印 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除图片和视频水印 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除信息流广告v2 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v6\/homefeed\?, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除搜索页广告 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/v10\/search\/notes\?, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

移除视频水印 = type=http-response, pattern=^https:\/\/(?:[^\/]*\.)?(?:xiaohongshu\.com|rnote\.com|rednote\.com|rednote\.life|rednotecdn\.com)\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save), script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js, requires-body=true

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com, *.rnote.com, *.rednote.com, *.rednote.life
